# Production Environment Configuration Template
# Copy this to .env on production server or set via CI/CD secrets

# Application Mode
APP_ENV=production
APP_URL=https://prhub.shop
FRONTEND_URL=https://prhub.shop

# Database Connection
DB_HOST=localhost
DB_NAME=store
DB_USER=store_user
DB_PASS=secure_password_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=noreply@prhub.shop
SMTP_PASSWORD=email_password_here
SMTP_FROM_EMAIL=noreply@prhub.shop
SMTP_FROM_NAME=PR Hub

# Payment Gateways (Kora)
KORA_SECRET_KEY=sk_live_your_key_here
KORA_PUBLIC_KEY=pk_live_your_key_here
KORA_API_URL=https://api.korapay.com/merchant/api/v1
KORA_ENVIRONMENT=production

# Security
ENCRYPTION_KEY=your_32_character_random_key_here
