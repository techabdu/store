}

/* Success Message */
.success-message-container {
    text-align: center;
    padding: 2rem 1rem;
}

.success-icon {
    font-size: 5rem;
    color: var(--lp-secondary);
    margin-bottom: 1.5rem;
    animation: scaleIn 0.5s ease-out;
}

@keyframes scaleIn {
    from {
        transform: scale(0);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }
}

.success-message-container h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--lp-text-primary);
    margin-bottom: 1rem;
}

.success-message-container p {
    color: var(--lp-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
}

.email-instruction {
    background: var(--lp-light);
    padding: 1rem;
    border-radius: var(--lp-radius-sm);
    border-left: 4px solid var(--lp-primary);
    margin: 1.5rem 0;
}

.email-instruction strong {
    color: var(--lp-primary);
}

.success-actions {
    margin: 2rem 0;
}

.btn-primary {
    padding: 0.875rem 2rem;
    background-color: var(--lp-primary);
    color: white;
    border: none;
    border-radius: var(--lp-radius-lg);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background-color: var(--lp-primary-hover);
    box-shadow: var(--lp-shadow-medium);
    transform: translateY(-1px);
}

.resend-note {
    font-size: 0.85rem;
    color: var(--lp-text-secondary);
    margin-top: 1.5rem;
}

/* Plan Selection Styles */
.register-container.plan-selection {
    max-width: 1200px;
    background: transparent;
    box-shadow: none;
    border: none;
    padding: 0;
}

.register-container.plan-selection .register-header {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    padding: 2rem;
    border-radius: var(--lp-radius-lg);
    margin-bottom: 3rem;
    box-shadow: var(--lp-shadow-subtle);
}

.plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.plan-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-md);
    padding: 2.5rem 2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
}

.plan-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--lp-shadow-hover);
    background: white;
}

.plan-card.selected {
    border: 2px solid var(--lp-primary);
    transform: scale(1.02);
    box-shadow: var(--lp-shadow-medium);
    z-index: 2;
}

.plan-card.recommended {
    border-color: var(--lp-primary);
}

.recommended-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background-color: var(--lp-primary);
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
}

.plan-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--lp-text-primary);
    margin-bottom: 1rem;
}

.plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
}

.plan-price .currency {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--lp-text-primary);
}

.plan-price .price {
    font-size: 3rem;
    font-weight: 700;
    color: var(--lp-text-primary);
}

.plan-price .duration {
    font-size: 1rem;
    color: var(--lp-text-secondary);
}

.plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    flex: 1;
}

.plan-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    color: var(--lp-text-secondary);
    font-size: 0.95rem;
}

.plan-features .feature-icon {
    color: var(--lp-secondary);
    font-size: 1.1rem;
    flex-shrink: 0;
}

.plan-actions {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.continue-button {
    width: 100%;
    max-width: 300px;
    padding: 1rem 2rem;
    background-color: var(--lp-primary);
    color: white;
    border: none;
    border-radius: var(--lp-radius-lg);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.continue-button:hover {
    background-color: var(--lp-primary-hover);
    box-shadow: var(--lp-shadow-medium);
    transform: translateY(-2px);
}

.change-plan-btn {
    background: none;
    border: none;
    color: var(--lp-primary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    margin-top: 0.5rem;
    padding: 0;
}

.change-plan-btn:hover {
    color: var(--lp-primary-hover);
    text-decoration: underline;
}

/* Responsive Design */
@media (max-width: 768px) {
    .register-container {
        padding: 2rem 1.5rem;
    }

    .register-header h1 {
        font-size: 1.75rem;
    }

    .plans-grid {
        grid-template-columns: 1fr;
    }

    .plan-card.selected {
        transform: none;
    }
}

@media (max-width: 480px) {
    .register-page {
        padding: 1rem 0.5rem;
    }

    .register-container {
        padding: 1.5rem 1rem;
    }

    .input-wrapper input {
        padding: 0.75rem 0.875rem 0.75rem 2.75rem;
    }

    .input-icon {
        left: 0.875rem;
        font-size: 1rem;
    }
}

/* Progress Bar Styles */
.progress-container {
    margin-bottom: 2rem;
    position: relative;
    padding: 0 1rem;
}

.progress-bar-bg {
    height: 4px;
    background: var(--lp-border);
    border-radius: 2px;
    position: relative;
    top: 14px;
    z-index: 0;
}

.progress-bar-fill {
    height: 100%;
    background: var(--lp-primary);
    border-radius: 2px;
    transition: width 0.4s ease;
}

.progress-steps {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    margin-top: -18px;
}

.progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.6;
    transition: all 0.3s ease;
}

.progress-step.active {
    opacity: 1;
}

.progress-step.completed .step-circle {
    background: var(--lp-primary);
    color: white;
    border-color: var(--lp-primary);
}

.step-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--lp-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--lp-text-secondary);
    transition: all 0.3s ease;
}

.progress-step.active .step-circle {
    border-color: var(--lp-primary);
    color: var(--lp-primary);
    box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.1);
}

.step-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--lp-text-secondary);
}

.progress-step.active .step-label {
    color: var(--lp-primary);
    font-weight: 600;
}

/* Form Animations */
.form-section-animated {
    animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.form-navigation {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}

.btn-back {
    padding: 0.875rem 2rem;
    background: transparent;
    color: var(--lp-text-secondary);
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    flex: 1;
}

.btn-back:hover {
    background: var(--lp-light);
    color: var(--lp-text-primary);
}

.btn-next {
    padding: 0.875rem 2rem;
    background-color: var(--lp-primary);
    color: white;
    border: none;
    border-radius: var(--lp-radius-lg);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    flex: 2;
}

.btn-next:hover {
    background-color: var(--lp-primary-hover);
    box-shadow: var(--lp-shadow-medium);
    transform: translateY(-1px);
}

/* Split Layout Styles (Matching Login Page) */
.register-page.split-layout {
    padding: 0;
    background-color: var(--lp-white);
    overflow: hidden;
    /* Prevent scrolling if not needed */
}

.register-page.split-layout .register-container {
    display: flex;
    width: 100%;
    height: 100vh;
    max-width: none;
    padding: 0;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    border: none;
    border-radius: 0;
    animation: none;
}

/* Left Side - Visual Section */
.register-visual-section {
    flex: 1;
    background-color: #f8f9fa;
    /* Light background */
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

/* Right Side - Form Section */
.register-form-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px;
    background-color: var(--lp-white);
    overflow-y: auto;
    /* Allow scrolling if form is tall */
}

.register-form-section>* {
    width: 100%;
    max-width: 500px;
    /* Slightly wider for register form */
}

/* Adjustments for elements inside split layout */
.register-page.split-layout .register-header {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
    /* Above particles */
    max-width: 500px;
}

.register-page.split-layout .register-header h1 {
    font-size: 2.5rem;
    color: var(--lp-text-primary);
    margin-bottom: 1rem;
}

.register-page.split-layout .register-header p {
    color: var(--lp-text-secondary);
    font-size: 1.1rem;
}

.register-page.split-layout .progress-container {
    margin-left: 0;
    margin-right: 0;
    max-width: 100%;
    margin-bottom: 2rem;
}

/* Responsive Design for Split Layout */
@media (max-width: 900px) {
    .register-visual-section {
        display: none;
    }

    .register-form-section {
        flex: 1;
        padding: 20px;
    }

    .register-page.split-layout .register-container {
        height: auto;
        min-height: 100vh;
    }
}